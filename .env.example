# terraform output ai_services_endpoint
APP_AI_SERVICES_ENDPOINT=
APP_LOG_LEVEL=INFO
APP_PII_LANGUAGE=en
# 0.0 masks every detection Azure returns; raise (e.g. 0.8) to drop low-confidence matches.
APP_PII_MIN_CONFIDENCE=0.0
APP_INPUT_IMAGES_DIR=input-images
APP_OUTPUT_IMAGES_DIR=output-images
APP_INPUT_EMAILS_DIR=input-emails
APP_OUTPUT_EMAILS_DIR=output-emails
APP_TRACE_DIR=data/processed
