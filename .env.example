# terraform output ai_services_endpoint
APP_AI_SERVICES_ENDPOINT=
# Default OCR for new image-redaction workloads; alternative: document_intelligence
APP_OCR_PROVIDER=content_understanding
# terraform output content_understanding_endpoint (required for default images/all modes)
APP_CONTENT_UNDERSTANDING_ENDPOINT=
# terraform output document_intelligence_endpoint (only required for the alternative provider)
APP_DOCUMENT_INTELLIGENCE_ENDPOINT=
APP_LOG_LEVEL=INFO
APP_PII_LANGUAGE=en
# 0.0 masks every detection Azure returns; raise (e.g. 0.8) to drop low-confidence matches.
APP_PII_MIN_CONFIDENCE=0.0
APP_INPUT_IMAGES_DIR=input-images
APP_OUTPUT_IMAGES_DIR=output-images
APP_INPUT_EMAILS_DIR=input-emails
APP_OUTPUT_EMAILS_DIR=output-emails
APP_TRACE_DIR=data/processed
